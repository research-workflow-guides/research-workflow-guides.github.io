---
layout: layouts/base.njk
title: 함께 작업하기
description: 협업 워크플로우를 위한 한국어 카테고리 홈.
lang: ko
pageClass: page-section
---
{% set pageUi = canonical.pageUi[page.url] %}
{% set breadcrumbs = pageUi.breadcrumbs %}
{% set grouped = canonical.groupedDocs.ko["collaboration"] %}
<main class="content-shell">
  {% include "components/left-rail.njk" %}

  <article class="doc-content panel" data-pagefind-body>
    {% include "components/breadcrumbs.njk" %}

    <section class="doc-hero doc-hero-simple">
      <div>
        <p class="eyebrow">4단계</p>
        <h1>함께 작업하기</h1>
        <p class="lead">기본 Git과 GitHub 흐름이 안정된 뒤 여기로 넘어옵니다.</p>
      </div>
    </section>

    <section id="collaboration" class="doc-section">
      <h2>플랫폼</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped.collaboration %}
          <a class="feature-card panel" href="{{ doc.url }}">
            {% if doc.status == "optional" %}
              <p class="card-kicker">선택</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% else %}
              <p class="card-kicker">주제 {{ loop.index }}</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% endif %}
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="git-for-collaboration" class="doc-section">
      <h2>공동 작업을 위한 Git</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped["git-for-collaboration"] %}
          <a class="feature-card panel" href="{{ doc.url }}">
            {% if doc.status == "optional" %}
              <p class="card-kicker">선택</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% else %}
              <p class="card-kicker">주제 {{ doc.order }}</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% endif %}
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  </article>
</main>
