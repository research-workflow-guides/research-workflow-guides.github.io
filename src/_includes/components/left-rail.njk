{% set currentUrl = page.url %}
{% set currentPageMeta = canonical.pagesByUrl[currentUrl] %}
{% set currentPageUi = canonical.pageUi[currentUrl] %}
{% set currentLang = currentPageMeta.lang if currentPageMeta and currentPageMeta.lang != "root" else lang %}
{% set currentSection = currentPageUi.activeSection if currentPageUi else activeSection %}
{% set currentUi = ui[currentLang if currentLang == "ko" else "en"] %}
<aside class="page-sidebar" data-pagefind-ignore="all">
  <div class="mobile-document-bar"><span>{{ title }}</span><button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="page-navigation" data-toc-toggle>{{ currentUi.openContents }} <span aria-hidden="true">⌄</span></button></div>
  <nav id="page-navigation" class="sidebar-card-rail" aria-label="{{ currentUi.openContents }}" data-toc-panel data-open="false">
    <div class="sidebar-rail-scroll" data-toc-scroll>
      {% for section in navigation.sections %}
        {% if currentSection == section.key %}
          <a class="rail-section-title" href="{{ section.url[currentLang] }}">{{ section.title[currentLang] }}</a>
          {% for group in section.groupedPages[currentLang] %}
            <section class="rail-group">
              {% if group.key != "core" %}<a class="rail-link-group" href="{{ section.url[currentLang] }}#{{ group.key }}-documents">{{ group.label }}</a>{% endif %}
              <ul class="rail-pages">
              {% for item in group.pages %}
                <li><a class="rail-link rail-link-page{% if currentUrl == item.url %} is-current{% endif %}" href="{{ item.url }}"{% if currentUrl == item.url %} aria-current="page"{% endif %}>{{ title if currentUrl == item.url else item.title }}</a></li>
              {% endfor %}
              </ul>
            </section>
          {% endfor %}
        {% endif %}
      {% endfor %}
      {% if toc and toc.length %}
        <section class="rail-local"><h2>{{ currentUi.contents }}</h2><ol class="rail-headings">
        {% for heading in toc %}
          <li><a class="rail-link rail-link-heading" href="#{{ heading.id }}"><span class="rail-number" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><span>{{ heading.label }}</span></a>
          {% if heading.children and heading.children.length %}<ul class="rail-children">
            {% for child in heading.children %}<li><a class="rail-link rail-link-heading rail-link-heading-sub" href="#{{ child.id }}">{{ child.label }}</a></li>{% endfor %}
          </ul>{% endif %}</li>
        {% endfor %}
        </ol></section>
      {% endif %}
      <a class="rail-feedback" href="https://github.com/research-workflow-guides/research-workflow-guides.github.io/discussions">{{ currentUi.feedback }} <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</aside>
