{% for classification in canonical.classifications %}
  {% set docs = grouped[classification.key] %}
  {% if docs and docs.length %}
    <section id="{{ classification.key }}-documents" class="doc-section document-group document-group-{{ classification.key }}">
      <div class="document-group-heading"><h2>{{ classification.label[lang] }}</h2>{% if classification.summary %}<p class="subtle">{{ classification.summary[lang] }}</p>{% endif %}</div>
      <ol class="document-list">
        {% for doc in docs %}
          <li><a class="document-row document-card-{{ classification.key }}" href="{{ doc.url }}">
            <span class="document-number" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <div><h3>{{ doc.title }}</h3><p>{{ doc.description }}</p></div>
            <span class="document-arrow" aria-hidden="true">↗</span>
          </a></li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}
{% endfor %}
