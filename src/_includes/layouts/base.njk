<!doctype html>
<html lang="{{ lang if lang == 'ko' else 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.url == "/" %}{{ site.name }}{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <script>document.documentElement.classList.add("js");</script>
    <link rel="stylesheet" href="/site-assets/styles.css?v={{ build.assetVersion }}">
  </head>
  {% set currentPageMeta = canonical.pagesByUrl[page.url] %}
  {% set currentPageUi = canonical.pageUi[page.url] %}
  {% set isRootLanding = currentPageMeta and currentPageMeta.pageType == "root-landing" %}
  {% set currentLang = currentPageMeta.lang if currentPageMeta and currentPageMeta.lang != "root" else (null if isRootLanding else lang) %}
  {% set currentUi = ui[currentLang if currentLang == "ko" else "en"] %}
  {% set currentSection = currentPageUi.activeSection if currentPageUi else activeSection %}
  <body class="{{ pageClass or '' }}{% if currentSection %} section--{{ currentSection }}{% endif %}" data-page-lang="{{ lang or '' }}">
    <a class="skip-link" href="#main-content">{{ currentUi.skipContent }}</a>
    {% set currentLangSwitch = currentPageUi.langSwitch if currentPageUi else langSwitch %}
    <header class="site-header{% if isRootLanding %} site-header-root{% endif %}" data-pagefind-ignore="all">
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="{{ site.name }}"><span class="brand-mark" aria-hidden="true">[ ]</span><span>Research Workflow<br>Guidebook</span></a>

        {% if currentLang %}
          <nav id="primary-nav" class="site-nav" aria-label="{{ currentUi.navigation }}" data-open="false">
            {% for section in navigation.sections %}
              <a
                class="nav-section--{{ section.key }}"
                href="{{ section.url[currentLang] }}"
                {% if currentSection == section.key %}aria-current="page"{% endif %}
              >{{ section.navTitle[currentLang] }}</a>
            {% endfor %}
          </nav>
        {% endif %}
        {% if currentLang == "en" or currentLang == "ko" %}
          <div class="header-actions">
            {% if currentLangSwitch %}
              <a class="lang-switch" href="{{ currentLangSwitch.url }}" lang="{{ 'en' if currentLang == 'ko' else 'ko' }}" aria-label="{{ currentLangSwitch.label }}">{{ 'EN' if currentLang == 'ko' else '한국어' }}</a>
            {% endif %}
            <button
              class="nav-search-button"
              type="button"
              aria-expanded="false"
              aria-controls="site-search-panel"
              data-header-search-toggle
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="visually-hidden">{{ currentUi.search }}</span>
            </button>
            <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span class="visually-hidden">{{ currentUi.menu }}</span>
            </button>
          </div>
        {% endif %}
      </div>
      {% if currentLang == "en" or currentLang == "ko" %}
        <div id="site-search-panel" class="wrap header-search-shell" data-header-search-panel data-open="false">
          <section class="header-search-panel" data-search-root data-search-lang="{{ currentLang }}" data-pagefind-ignore="all">
            <label class="search-label visually-hidden" for="site-search-input">
              {% if currentLang == "ko" %}
                문서 검색
              {% else %}
                Search the docs
              {% endif %}
            </label>
            <input
              id="site-search-input"
              class="search-input"
              type="search"
              autocomplete="off"
              placeholder="{% if currentLang == 'ko' %}예: GitHub, LaTeX, branch{% else %}e.g. GitHub, LaTeX, branch{% endif %}"
              data-search-input
            >
            <p class="search-status" role="status" aria-live="polite" data-search-status></p>
            <div class="search-results" data-search-results></div>
          </section>
        </div>
      {% endif %}
    </header>

    {{ content | safe }}

    <footer class="site-footer" data-pagefind-ignore="all">
      <div class="wrap footer-inner">
        <p class="footer-brand">{{ site.name }}</p>
        <p class="footer-copy">&copy; 2026 {{ site.authorLine }}</p>
        {% set latestFooterDate = git.latestCommitDate %}
        {% if latestFooterDate %}
          <p class="footer-update">{{ currentUi.latestUpdate }} {{ latestFooterDate | dateDots }}</p>
        {% endif %}
        <div class="footer-links">
          <a class="footer-old-version" href="{{ site.oldVersionUrl }}">{{ currentUi.oldVersion }}</a>
          <a class="footer-support" href="{{ site.sponsorUrl }}">{{ currentUi.support }}</a>
        </div>
      </div>
    </footer>

    <dialog id="image-viewer" class="image-viewer" aria-labelledby="image-viewer-title">
      <div class="image-viewer-toolbar"><h2 id="image-viewer-title">{{ currentUi.imageViewer }}</h2><button type="button" data-image-viewer-close>{{ currentUi.closeImage }} <span aria-hidden="true">×</span></button></div>
      <div class="image-viewer-content"><img data-image-viewer-image alt=""></div>
      <p data-image-viewer-caption></p>
    </dialog>
    <script src="/site-assets/app.js?v={{ build.assetVersion }}" defer></script>
  </body>
</html>
