<!doctype html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@400;700&family=Noto+Sans+KR:wght@400;500;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="/site-assets/styles.css?v={{ build.assetVersion }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  {% set currentPageMeta = canonical.pagesByUrl[page.url] %}
  {% set currentPageUi = canonical.pageUi[page.url] %}
  {% set currentLang = currentPageMeta.lang if currentPageMeta and currentPageMeta.lang != "root" else lang %}
  {% set currentUi = ui[currentLang if currentLang == "ko" else "en"] %}
  {% set currentSection = currentPageUi.activeSection if currentPageUi else activeSection %}
  <body class="{{ pageClass or '' }}{% if currentSection %} section--{{ currentSection }}{% endif %}" data-page-lang="{{ lang or '' }}">
    {% set currentLangSwitch = currentPageUi.langSwitch if currentPageUi else langSwitch %}
    <header class="site-header" data-pagefind-ignore="all">
      <div class="wrap site-header-inner">
        <a class="brand" href="/">{{ site.name }}</a>

        {% if navStyle == "legacy-en" %}
          <nav id="primary-nav" class="site-nav" aria-label="Primary">
            {% for item in navigation.legacy.en %}
              <a
                href="{{ item.url }}"
                {% if currentSection == item.key %}aria-current="page"{% endif %}
              >
                {{ item.label }}
              </a>
            {% endfor %}
          </nav>
        {% elif navStyle == "legacy-ko-section" %}
          <nav id="primary-nav" class="site-nav" aria-label="Primary">
            {% for item in navigation.legacy.koSection %}
              <a
                href="{{ item.url }}"
                {% if currentSection == item.key %}aria-current="page"{% endif %}
              >
                {{ item.label }}
              </a>
            {% endfor %}
          </nav>
        {% elif currentLang %}
          <nav id="primary-nav" class="site-nav" aria-label="Primary">
            {% for section in navigation.sections %}
              {% set sectionNavPages = section.pages[currentLang] %}
              <div class="nav-dropdown{% if sectionNavPages and sectionNavPages.length %} has-menu{% endif %} nav-section--{{ section.key }}">
                <a
                  href="{{ section.url[currentLang] }}"
                  {% if currentSection == section.key %}aria-current="page"{% endif %}
                >{{ section.title[currentLang] }}</a>
                {% if sectionNavPages and sectionNavPages.length %}
                  <div class="dropdown-menu">
                    {% for docPage in sectionNavPages %}
                      <a href="{{ docPage.url }}">{{ docPage.title }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </nav>
        {% else %}
          <nav class="site-nav site-nav-root" aria-label="Primary">
            {% for language in navigation.languages %}
              <a href="{{ language.url }}">{{ language.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}
        {% if currentLang == "en" or currentLang == "ko" %}
          <div class="header-actions">
            {% if currentLangSwitch %}
              <a class="lang-switch" href="{{ currentLangSwitch.url }}">{{ currentLangSwitch.label }}</a>
            {% endif %}
            <button
              class="nav-search-button"
              type="button"
              aria-expanded="false"
              aria-controls="site-search-panel"
              data-header-search-toggle
            >
              {{ "검색" if currentLang == "ko" else "Search" }}
            </button>
          </div>
        {% endif %}
      </div>
      {% if currentLang == "en" or currentLang == "ko" %}
        <div id="site-search-panel" class="wrap header-search-shell" data-header-search-panel data-open="false">
          <section class="header-search-panel" data-search-root data-search-lang="{{ currentLang }}" data-pagefind-ignore="all">
            <label class="search-label visually-hidden" for="site-search-input">
              {% if currentLang == "ko" %}
                문서 검색
              {% else %}
                Search the docs
              {% endif %}
            </label>
            <input
              id="site-search-input"
              class="search-input"
              type="search"
              autocomplete="off"
              placeholder="{% if currentLang == 'ko' %}예: GitHub, LaTeX, branch{% else %}e.g. GitHub, LaTeX, branch{% endif %}"
              data-search-input
            >
            <p class="search-status" data-search-status></p>
            <div class="search-results" data-search-results></div>
          </section>
        </div>
      {% endif %}
    </header>

    {{ content | safe }}

    <footer class="site-footer" data-pagefind-ignore="all">
      <div class="wrap footer-inner">
        <p class="footer-brand">{{ site.name }}</p>
        <p class="footer-copy">&copy; 2026 {{ site.authorLine }}</p>
        {% set latestFooterDate = git.latestCommitDate or (updates.latest.date if updates.latest else null) %}
        {% if latestFooterDate %}
          <p class="footer-update">{{ currentUi.latestUpdate }} {{ latestFooterDate | dateDots }}</p>
        {% endif %}
        <a class="footer-old-version" href="{{ site.oldVersionUrl }}">{{ currentUi.oldVersion }}</a>
      </div>
    </footer>

    <script src="/site-assets/app.js?v={{ build.assetVersion }}" defer></script>
  </body>
</html>
