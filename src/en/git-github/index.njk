---
layout: layouts/base.njk
title: Manage with GitHub
description: English category home for Git and GitHub workflows.
lang: en
pageClass: page-section
---
{% set pageUi = canonical.pageUi[page.url] %}
{% set breadcrumbs = pageUi.breadcrumbs %}
{% set grouped = canonical.groupedDocs.en["git-github"] %}
<main class="content-shell">
  {% include "components/left-rail.njk" %}

  <article class="doc-content panel" data-pagefind-body>
    {% include "components/breadcrumbs.njk" %}

    <section class="doc-hero doc-hero-simple">
      <div>
        <p class="eyebrow">Step 3</p>
        <h1>Manage with GitHub</h1>
        <p class="lead">Start here once your project template compiles locally.</p>
      </div>
    </section>

    <section id="preparation" class="doc-section">
      <h2>Preparation</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped.preparation %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">Step {{ loop.index }}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="first-github-workflow" class="doc-section">
      <h2>First GitHub workflow</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped["first-github-workflow"] %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">Step {{ loop.index + 3 }}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="daily-workflow" class="doc-section">
      <h2>Daily workflow</h2>
      <div class="feature-grid feature-grid-compact feature-grid-equal-cards">
        {% for doc in grouped["daily-workflow"] %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">{% if doc.status == "optional" %}Optional{% else %}Topic {{ loop.index }}{% endif %}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section class="callout-card">
      <p class="eyebrow">Next</p>
      <h2>Then collaborate with the team</h2>
      <p>Once daily Git workflows are stable, continue to shared repository collaboration.</p>
      <a class="text-link" href="/en/collaboration/">Go to Collaborate</a>
    </section>
  </article>
</main>
