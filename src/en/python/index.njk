---
layout: layouts/base.njk
title: Python
description: Use Python for reproducible analysis, automation, and research scripts.
lang: en
pageClass: page-section
permalink: /en/python/
toc:
  - id: installation
    label: Installation
  - id: backends
    label: Backends
  - id: visualization
    label: Visualization
  - id: acceleration
    label: Acceleration
---
{% set pageUi = canonical.pageUi[page.url] %}
{% set breadcrumbs = pageUi.breadcrumbs %}
{% set grouped = canonical.groupedDocs.en.python %}
{% set pythonDocs = grouped["python-basics"] %}
{% set backendDocs = grouped.backends %}
{% set visualizationDocs = grouped.visualization %}
{% set accelerationDocs = grouped.acceleration %}
<main class="content-shell">
  {% include "components/left-rail.njk" %}

  <article class="doc-content panel" data-pagefind-body>
    {% include "components/breadcrumbs.njk" %}

    <section class="doc-hero doc-hero-simple">
      <div>
        <p class="eyebrow">Python</p>
        <h1>Python</h1>
        <p class="lead">Use Python for reproducible analysis, automation, and research scripts.</p>
      </div>
    </section>

    <section id="installation" class="doc-section">
      <h2>Installation</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in pythonDocs %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">{% if doc.status == "optional" %}Optional{% else %}Step {{ doc.order }}{% endif %}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="backends" class="doc-section">
      <h2>Backends</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in backendDocs %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">Backend {{ loop.index }}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="visualization" class="doc-section">
      <h2>Visualization</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in visualizationDocs %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">Topic {{ loop.index }}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="acceleration" class="doc-section">
      <h2>Acceleration</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in accelerationDocs %}
          <a class="feature-card panel" href="{{ doc.url }}">
            <p class="card-kicker">Tool {{ loop.index }}</p>
            <h3>{{ doc.title }}</h3>
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  </article>
</main>
