---
layout: layouts/base.njk
title: Collaborate
description: English category home for collaboration workflows.
lang: en
pageClass: page-section
---
{% set pageUi = canonical.pageUi[page.url] %}
{% set breadcrumbs = pageUi.breadcrumbs %}
{% set grouped = canonical.groupedDocs.en["collaboration"] %}
<main class="content-shell">
  {% include "components/left-rail.njk" %}

  <article class="doc-content panel" data-pagefind-body>
    {% include "components/breadcrumbs.njk" %}

    <section class="doc-hero doc-hero-simple">
      <div>
        <p class="eyebrow">Step 4</p>
        <h1>Collaborate</h1>
        <p class="lead">Move here once the basic Git and GitHub workflow is stable.</p>
      </div>
    </section>

    <section id="collaboration" class="doc-section">
      <h2>Platforms</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped.collaboration %}
          <a class="feature-card panel" href="{{ doc.url }}">
            {% if doc.status == "optional" %}
              <p class="card-kicker">Optional</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% else %}
              <p class="card-kicker">Topic {{ loop.index }}</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% endif %}
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <section id="git-for-collaboration" class="doc-section">
      <h2>Git for collaboration</h2>
      <div class="feature-grid feature-grid-compact">
        {% for doc in grouped["git-for-collaboration"] %}
          <a class="feature-card panel" href="{{ doc.url }}">
            {% if doc.status == "optional" %}
              <p class="card-kicker">Optional</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% else %}
              <p class="card-kicker">Topic {{ doc.order }}</p>
              {% if doc.logo %}
                <img class="feature-card-logo" src="{{ doc.logo }}" alt="{{ doc.title }}">
              {% else %}
                <h3>{{ doc.title }}</h3>
              {% endif %}
            {% endif %}
            <p>{{ doc.description }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  </article>
</main>
